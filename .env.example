# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sim_tech_institute_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_this_in_production_min_32_chars
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_change_this
JWT_REFRESH_EXPIRE=30d

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# School Configuration (Default)
SCHOOL_NAME=SIM Technology Institute
SCHOOL_ADDRESS=Brooklyn Community, Lofa Road, Gbarnga City, Bong County - Liberia
SCHOOL_PHONE=+231880857969
SCHOOL_EMAIL=quelemineisaacl@gmail.com
PRIMARY_COLOR=#ADD8E6
SECONDARY_COLOR=#800080
ACCENT_COLOR=#FFFFFF

# AI Configuration (Optional - for future integration)
OPENAI_API_KEY=your_openai_api_key

# Email Configuration (Optional - for future integration)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email
SMTP_PASS=your_password
SMTP_FROM=noreply@simtechinstitute.edu

# Backup Configuration
BACKUP_PATH=./backups
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
