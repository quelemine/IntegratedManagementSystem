# Production Environment Configuration
# Copy this file to .env and update with your production values

# Application
NODE_ENV=production
PORT=5000
CLIENT_URL=https://your-production-domain.com

# Database
DB_CLIENT=pg
DB_HOST=your-production-db-host
DB_PORT=5432
DB_NAME=integrated_management_system
DB_USER=your_production_db_user
DB_PASSWORD=your_secure_db_password

# JWT Configuration
JWT_SECRET=your_very_secure_jwt_secret_key_minimum_32_characters
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_very_secure_refresh_secret_key_minimum_32_characters
JWT_REFRESH_EXPIRE=30d

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=https://your-production-domain.com

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=logs

# Email Configuration (if needed)
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@your-domain.com

# Session Configuration
SESSION_SECRET=your_session_secret_key
SESSION_MAX_AGE=86400000

# Redis Configuration (if using Redis for caching)
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Monitoring
ENABLE_MONITORING=true
SENTRY_DSN=your_sentry_dsn_if_using_sentry
